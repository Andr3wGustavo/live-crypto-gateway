NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
# Replace before using persistent accounts. Never commit actual secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=livecrypto
REDIS_URL=redis://localhost:6379
DEV_MEMORY_MODE=false
# Set true only after the EVM router is deployed, the migration is applied and
# an end-to-end testnet donation has been reconciled through the outbox.
DONATIONS_ENABLED=false
PLATFORM_FEE_BPS=200
EVM_CHAIN_ID=80002
EVM_CONFIRMATIONS=3
EVM_ROUTER_ADDRESS=
EVM_RPC_URL=https://rpc-amoy.polygon.technology
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_ADDRESS=
PUBLIC_TTS_ENABLED=false
