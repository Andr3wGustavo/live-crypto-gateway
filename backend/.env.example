NODE_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
# Replace before using persistent accounts. Never commit actual secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=livecrypto
REDIS_URL=redis://localhost:6379
DEV_MEMORY_MODE=false
# Set true only after the EVM router is deployed, the migration is applied and
# an end-to-end testnet donation has been reconciled through the outbox.
DONATIONS_ENABLED=false
PLATFORM_FEE_BPS=200
EVM_CHAIN_ID=80002
EVM_CONFIRMATIONS=3
EVM_ROUTER_ADDRESS=
EVM_TREASURY_ADDRESS=
EVM_RPC_URL=https://rpc-amoy.polygon.technology
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional browser-safe endpoint. Keep SOLANA_RPC_URL private when it contains
# a provider API key; this URL is the only one exposed by the public config.
SOLANA_PUBLIC_RPC_URL=
SOLANA_TREASURY_ADDRESS=
# Sui identity and payout are live as soon as SUI_NETWORK is set. The donation
# rail additionally requires a validated Move package; leaving SUI_PACKAGE_ID
# empty keeps Sui checkout disabled without hiding the payout selector.
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PUBLIC_RPC_URL=
SUI_TREASURY_ADDRESS=
SUI_PACKAGE_ID=
PUBLIC_TTS_ENABLED=false
